{
  "rule": "NMS suppresses a box whose IoU with an already kept box EQUALS iou_threshold (>=, not >). IoU = 0.5 / (0.75 + 0.75 - 0.5) = 0.5",
  "postprocess": {
    "decoder": "yolo_pro",
    "labels": [
      "bicycle",
      "stop sign"
    ],
    "score_threshold": 0.5,
    "iou_threshold": 0.5,
    "max_detections": 200
  },
  "columns": [
    "xmin",
    "ymin",
    "xmax",
    "ymax",
    "score:bicycle",
    "score:stop sign"
  ],
  "rows": [
    [
      0,
      0,
      0.75,
      1,
      0.875,
      0
    ],
    [
      0.25,
      0,
      1,
      1,
      0.75,
      0
    ]
  ],
  "detections": [
    {
      "label": "bicycle",
      "score": 0.875,
      "box": {
        "x": 0,
        "y": 0,
        "w": 0.75,
        "h": 1
      }
    }
  ]
}
